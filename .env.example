# Copy to .env; the app loads it without executing shell code.
LAUNCH_MODE=dry_run
FREE_FEED_ENABLED=1
ENABLE_PAID_X=0
# For automatic on-chain creation: set live, configure Pinata, create a dedicated
# treasury with `npm run wallet:create`, then fund it yourself.
# LAUNCH_MODE=live
PINATA_JWT=
# Leave unset to use data/wallets/treasury.json relative to this checkout.
# SOLANA_KEYPAIR_PATH=/absolute/path/to/dedicated-wallet.json
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional, paid; disabled even when a key is present unless ENABLE_PAID_X=1.
X_BEARER_TOKEN=
X_QUERY=("open source" OR "AI agents") has:links -is:retweet

# Optional Grok seats. Key stays in the Python process, not the browser.
GROK_ENABLED=0
XAI_API_KEY=
GROK_MODEL=grok-4.7
# Four requests per review, at most 12 requests per rolling 24h, including failures.
GROK_DAILY_CALLS=12
# Browser research never enters token launch queue unless explicitly enabled.
SPIDER_ALLOW_LAUNCH=0

# Launch platform: pumpportal (built-in) or bridge (your platform adapter).
LAUNCH_PROVIDER=pumpportal
# A bridge implements docs/LAUNCH_PROVIDERS.md; not an arbitrary platform homepage.
LAUNCH_BRIDGE_URL=
LAUNCH_BRIDGE_NAME=My launch platform
LAUNCH_BRIDGE_CHAIN=solana
LAUNCH_BRIDGE_TOKEN=
# Explicit trust in the bridge operator to enforce spend limits and manage signing.
LAUNCH_BRIDGE_TRUSTED=0

# Separate read-only Solana radar. No launch/wallet credentials are needed.
# Local default SQLite; set a PostgreSQL DSN for persistent hosted collection.
RADAR_DATABASE_URL=data/radar.sqlite
RADAR_USERNAME=
# Required for public hosting: at least 20 characters, generated locally.
RADAR_PASSWORD=
RADAR_MARKETS_PER_CYCLE=15
# Optional independent finalized mint/authority and largest-account checks.
# Bounded to two mints per ranking cycle; public RPC availability is limited.
RADAR_ONCHAIN_ENABLED=0
RADAR_RPC_URL=https://api.mainnet-beta.solana.com
# Optional local spider database for mint-attributed social evidence.
GEM_CAPTURE_DATABASE=data/gem-search.sqlite
# Explicit opt-in only; one alert per mint per day, global 15-minute cooldown.
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
